! name: Decorporate
! description: Prioritize sites that aren't owned by a "do be evil" corporation, don't engage in censorship, forced content, etc, with a lens towards what I personally find value in.
! public: false
! author: okkays
! homepage: https://github.com/okkays
! issues: https://github.com/okkays/decorporate.goggle/issues
! avatar: #458588
! license: CC0

! ============================================================
! Corporate capture sites (DOWNRANK HARD)
! ============================================================
$downrank=10,site=reddit.com
$downrank=10,site=tiktok.com
$downrank=10,site=salesforce.com
$downrank=10,site=accenture.com
$downrank=10,site=amazon.com

! ============================================================
! BOOST — Known good social sites
! ============================================================
$boost,site=lemmy.ml
$boost,site=piefed.social
$boost,site=substack.com
$boost,site=mastodon.social

! ============================================================
! BOOST — Known good other sites
! ============================================================
